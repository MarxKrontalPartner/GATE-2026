    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.86.3",
